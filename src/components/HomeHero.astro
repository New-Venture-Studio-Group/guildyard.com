---
import Logo from "./Logo.astro";
---
<section class="home-hero" aria-label="Guildyard">
  <div class="home-hero-media" aria-hidden="true">
    <video
      class="home-hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/assets/video/guildyard-workshop-poster.jpg"
      disablepictureinpicture
    >
      <source src="/assets/video/guildyard-workshop.mp4" type="video/mp4" />
    </video>
    <div class="home-hero-overlay"></div>
  </div>
  <div class="home-hero-copy">
    <Logo variant="lockup" tone="ivory" height={36} />
    <p class="home-hero-tagline">Built on Intent. Focused on Value.</p>
  </div>
</section>

<style>
.home-hero{
  position:relative;
  width:100%;
  min-height:74vh;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  background-color:#1a1b1e;
  background-image:url("/assets/video/guildyard-workshop-poster.jpg");
  background-repeat:no-repeat;
  background-size:cover;
  background-position:center 22%;
  color:var(--gy-ink-50);
}
.home-hero-media{
  position:absolute;
  inset:0;
}
.home-hero-video{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 22%;
  display:block;
}
.home-hero-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(180deg, rgba(23,24,28,.34) 0%, rgba(23,24,28,.26) 50%, rgba(23,24,28,.40) 100%);
}
.home-hero-copy{
  position:relative;
  z-index:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:36px;
  padding:96px 28px 48px;
  text-align:center;
  max-width:640px;
}
.home-hero-copy :global(img){
  height:32px;
  width:auto;
}
.home-hero-tagline{
  margin:0;
  font:var(--gy-weight-semibold) clamp(18px, 2vw, 22px)/1.4 var(--gy-font-serif);
  letter-spacing:.04em;
  color:rgba(246,243,238,.92);
}

@media (min-width: 801px){
  .home-hero{min-height:76vh}
  .home-hero-copy{gap:40px;padding:108px 32px 56px}
  .home-hero-copy :global(img){height:40px}
}

@media (max-width: 800px){
  .home-hero-video{display:none}
  .home-hero{min-height:70vh;background-position:center 18%}
}
@media (prefers-reduced-motion: reduce){
  .home-hero-video{display:none}
}
</style>

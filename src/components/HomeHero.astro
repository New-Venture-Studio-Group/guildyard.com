---
import Logo from "./Logo.astro";
---
<section class="home-hero" aria-label="Guildyard">
  <div class="home-hero-media" aria-hidden="true">
    <video
      class="home-hero-video"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="auto"
      poster="/assets/video/guildyard-workshop-poster.jpg"
      disablepictureinpicture
    >
      <source src="/assets/video/guildyard-workshop.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="home-hero-copy">
    <Logo variant="lockup" tone="ivory" height={32} />
    <p class="home-hero-tagline">Built on Intent. Focused on Value.</p>
  </div>
</section>

<script>
  const video = document.querySelector(".home-hero-video");
  if (video instanceof HTMLVideoElement) {
    video.muted = true;
    const play = () => video.play().catch(() => {});
    play();
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) play();
    });
  }
</script>

<style>
.home-hero{
  position:relative;
  width:100%;
  min-height:58vh;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  background:#1a1b1e url("/assets/video/guildyard-workshop-poster.jpg") center 30%/cover no-repeat;
  color:var(--gy-ink-50);
}
.home-hero-media{
  position:absolute;
  inset:0;
}
.home-hero-video{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 30%;
  display:block;
}
.home-hero-copy{
  position:relative;
  z-index:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:32px;
  padding:88px 28px 40px;
  text-align:center;
}
.home-hero-copy :global(img){height:28px;width:auto}
.home-hero-tagline{
  margin:0;
  font:var(--gy-weight-semibold) clamp(17px, 1.8vw, 20px)/1.4 var(--gy-font-serif);
  letter-spacing:.04em;
  color:rgba(246,243,238,.94);
}

@media (min-width: 801px){
  .home-hero{min-height:62vh}
  .home-hero-copy{gap:36px;padding:96px 32px 48px}
  .home-hero-copy :global(img){height:34px}
}

@media (prefers-reduced-motion: reduce){
  .home-hero-video{display:none}
}
</style>

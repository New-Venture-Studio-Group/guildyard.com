---
---
<section class="home-hero" aria-label="Workshop">
  <video
    class="home-hero-video"
    autoplay
    muted
    loop
    playsinline
    webkit-playsinline
    preload="auto"
    poster="/assets/video/guildyard-workshop-poster.jpg"
    disablepictureinpicture
    width="688"
    height="464"
  >
    <source src="/assets/video/guildyard-workshop.mp4" type="video/mp4" />
  </video>
</section>

<script>
  const video = document.querySelector(".home-hero-video");
  if (video instanceof HTMLVideoElement) {
    video.muted = true;
    const play = () => video.play().catch(() => {});
    play();
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) play();
    });
  }
</script>

<style>
.home-hero{
  width:100%;
  max-width:860px;
  margin:0 auto;
  padding:8px 20px 0;
  background:var(--gy-surface-page, var(--gy-ink-50));
}
.home-hero-video{
  display:block;
  width:100%;
  height:auto;
  max-height:320px;
  object-fit:cover;
  object-position:center bottom;
  background:#111;
}
@media (min-width: 801px){
  .home-hero{padding-top:12px}
  .home-hero-video{max-height:340px}
}
@media (prefers-reduced-motion: reduce){
  .home-hero-video{display:none}
  .home-hero{
    min-height:200px;
    background:#111 url("/assets/video/guildyard-workshop-poster.jpg") center bottom / cover no-repeat;
  }
}
</style>
